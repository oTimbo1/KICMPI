# KicMPi RAG web app — environment (copy to `.env` and adjust if needed)
#
# All model endpoints can ALSO be set — and changed at any time — in the app's
# Settings tab (http://<server>:8090, tab "Instellingen"). Values set there
# override the ones below and are persisted to a Docker volume, so a changing
# model-system IP is a UI-only matter (no file edits, no restart).

# Published frontend port on the host (bound to 0.0.0.0 for LAN access)
APP_PORT=8090

# Qdrant (internal Docker network — normally leave as-is)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kicmpi_documents

# Qdrant dashboard: the container's built-in dashboard + REST API are
# published on this host port (see docker-compose.yml). The app's header links
# to it from the Qdrant status dot.
QDRANT_DASHBOARD_PORT=6333

# ── Model endpoints (model system on the LAN) ────────────────────────────────
# Defaults point at the project's model system (verified reachable 2026-11-02).
# 🔒 PORT POLICY: port 8080 on the model system is RESERVED (pre-existing
#    non-RAG service) — the RAG system must never use it. RAG ports: 8081
#    embedding, 8082 summary, 8083 whisper (later), 8084 VLM (later).

# 1. BGE-M3 — embeddings (llama.cpp --embedding)
EMBEDDING_BASE_URL=http://192.168.69.20:8081
EMBEDDING_MODEL=bge-m3
# BGE-M3 dense vector size — changing this later requires wiping the Qdrant volume
EMBED_DIMS=1024

# 2. Qwen3-8B — grounded summaries (llama-server)
SUMMARY_BASE_URL=http://192.168.69.20:8082
SUMMARY_MODEL=qwen3-8b

# 3+4. Reserved for the full pipeline (later sprints) — stored, unused in v1
VLM_BASE_URL=http://192.168.69.20:8084
VLM_MODEL=qwen3-vl-8b-instruct
ASR_BASE_URL=http://192.168.69.20:8083
ASR_MODEL=whisper-large-v3

# 1 = deterministic mock embedder. OFFLINE DEVELOPMENT FALLBACK ONLY (off by
# default): lets the whole flow dry-run even if no model server is reachable.
# The app labels it "demo-modus". Toggling requires re-ingesting documents.
EMBED_MOCK=0

# Upload limit for PDFs (MB)
UPLOAD_MAX_MB=25
